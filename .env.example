# 1. Local SQLite Database
DATABASE_URL="file:./dev.db"

# 2. Google OAuth 2.0 Credentials (100% Completely Free Forever)
# Get from: Google Cloud Console (https://console.cloud.google.com/)
# Path: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID (Web application)
# Authorized Origins: http://localhost:3008
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# 3. Firebase Authentication Credentials (10,000 Free Phone SMS/month & Google Auth)
# Get from: Firebase Console (https://console.firebase.google.com/)
# Path: Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# 4. Google Maps Platform (Optional: GIS locator operates via OpenStreetMap if left empty)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# 5. Administrative Passkey for /admin
ADMIN_PASSKEY="NSFDC@2026"
