{
  "name": "sahayak-nsfdc",
  "version": "1.0.0",
  "private": true,
  "description": "Sahayak — Rural-first, multilingual NSFDC scheme discovery and repayment estimation platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node scripts/prepare-prisma.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "node scripts/prepare-prisma.js && prisma generate",
    "lint": "next lint",
    "test": "DATABASE_URL=\"file:./dev.db\" vitest run",
    "test:watch": "DATABASE_URL=\"file:./dev.db\" vitest",
    "db:migrate": "DATABASE_URL=\"file:./dev.db\" prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "node scripts/prepare-prisma.js && prisma generate",
    "db:push": "node scripts/prepare-prisma.js && prisma db push",
    "db:deploy": "node scripts/prepare-prisma.js && prisma db push",
    "db:seed": "node scripts/prepare-prisma.js && npx -y tsx src/lib/seedVerifiedSchemes.ts && npx -y tsx src/lib/seedPartners.ts",
    "seed:partners": "npx -y tsx src/lib/seedPartners.ts",
    "seed:schemes": "npx -y tsx src/lib/seedVerifiedSchemes.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@supabase/supabase-js": "^2.109.0",
    "@types/leaflet": "^1.9.22",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
